# =============================================================================
# AI-PRIORI — FRONTEND ENV
# React · Vite
# Copy to frontend/.env (dev) — or pass as Docker build args in production.
# All vars must start with VITE_ to be exposed to the browser bundle.
# =============================================================================

# URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth client ID (same value as GOOGLE_CLIENT_ID in the backend)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
